<?xml version="1.0"?>
<package format="3">
  <name>franka_teleop_controller</name>
  <version>0.1.0</version>
  <description>Teleoperation-specific direct-libfranka Cartesian impedance controller and gripper worker.</description>
  <maintainer email="maintainer@example.com">Franka Teleoperation</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>franka_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>quest_teleop_interfaces</depend>
  <depend>libfranka</depend>
  <depend>eigen</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>rclpy</test_depend>
  <exec_depend>quest_teleop</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
