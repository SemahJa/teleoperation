<?xml version="1.0"?>
<package format="3">
  <name>teleop_bringup</name>
  <version>0.1.0</version>
  <description>Composable launch of Quest input, arm controllers, grippers and recording.</description>
  <maintainer email="maintainer@example.com">Franka Teleoperation</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>quest_teleop</exec_depend>
  <exec_depend>teleop_controllers</exec_depend>
  <exec_depend>teleop_gripper</exec_depend>
  <exec_depend>safety_filter</exec_depend>
  <exec_depend>recording</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>rcl_interfaces</test_depend>
  <test_depend>std_msgs</test_depend>
  <test_depend>quest_teleop_interfaces</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
