<?xml version="1.0"?>
<package format="3">
  <name>quest_teleop</name>
  <version>0.1.0</version>
  <description>USB Quest telemetry reception, mapping, and per-arm launch configuration.</description>
  <maintainer email="maintainer@example.com">Franka Teleoperation</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>rclcpp</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <depend>geometry_msgs</depend>
  <depend>quest_teleop_interfaces</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rosbag2</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_index_python</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
